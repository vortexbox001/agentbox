# copy to .env and fill in — .env is gitignored

# --- The three roots (file layout) ------------------------------------------
# agentbox resolves every path from exactly three root directories, read once in
# orchestrator/paths.py and ui/config.py. Leave them unset to take the defaults
# below (the stack starts with none of these set); set them to relocate a root to
# any disk. See the "Layout" section of README.md.
#
#   AGENTBOX_CONFIG  instance configuration (agents, prompts, LiteLLM overlay).
#                    Default: <checkout>/config. Gitignored in this repo, so it may
#                    be its own git repo. Written by the UI.
#   AGENTBOX_DATA    instance state (runs, outputs, workspaces, credentials, keys).
#                    Default: /data/agentbox. Backed up as a unit.
#   DAGSTER_HOME     Dagster's own storage (run DB, compute logs, PIPES transport).
#                    Default: /data/dagster. Holds nothing agentbox-owned.
#AGENTBOX_CONFIG=/data/agentbox-config
#AGENTBOX_DATA=/data/agentbox
#DAGSTER_HOME=/data/dagster

# Absolute path of this checkout on the Docker host. The orchestrator runs inside a
# container but launches agent containers via the host's Docker socket, so it needs
# the *host* path to bind-mount prompt files. It is also the base for the default
# config root (<host repo>/config). Defaults to /home/vortex/GitHub/agentbox.
AGENTBOX_HOST_REPO=/home/vortex/GitHub/agentbox

# LiteLLM proxy admin key. Also the key every api-harness agent presents to the proxy
# (the orchestrator forwards it into the container as LITELLM_KEY).
LITELLM_MASTER_KEY=sk-change-me
ANTHROPIC_API_KEY=sk-ant-...        # backs every LiteLLM alias, i.e. all api-harness agents
DAGSTER_HOST_PORT=3000              # host port for the Dagster UI
#DAGSTER_PUBLIC_URL=                 # browser-facing Dagster URL for UI links; blank = derive from the request host + Dagster port
#DAGSTER_LOCATION=definitions.py     # Dagster code-location name used in job links (/locations/<name>/jobs/<job>)
TZ=America/New_York                 # the box's clock: run-timestamp filenames/log paths AND the timezone agent crons run in (triggers:); unset = UTC
KIMI_API_KEY=sk-...                 # Moonshot platform key (platform.moonshot.ai), for the kimi aliases
GITHUB_TOKEN=ghp_...                # GitHub personal access token (classic ghp_ or fine-grained github_pat_) for repo access

# Auth for claude-code agents. Run `claude setup-token` once (needs a Claude subscription and a
# browser) and paste the printed long-lived token here. The orchestrator forwards it into each
# agent container. Leave unset to fall back to a copied login in
# $AGENTBOX_DATA/credentials/claude/.
CLAUDE_CODE_OAUTH_TOKEN=

# Host user the `ui` container runs as, so agent/prompt files it writes into the config
# root stay owned by you rather than root; bootstrap.sh also chowns the data-root subtree
# to this user. Find yours with `id -u` (uid) and `id -g` (gid). Defaults to 1000:1000.
AGENTBOX_UID=1000
AGENTBOX_GID=1000

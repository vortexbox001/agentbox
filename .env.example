# copy to .env and fill in — .env is gitignored

# --- File layout: instance roots --------------------------------------------
# agentbox resolves every path from three roots (read once in orchestrator/paths.py and
# ui/config.py): the two instance roots below, plus Dagster's own storage root DAGSTER_HOME
# (in the Dagster section). The stack starts with none set and uses the defaults shown;
# uncomment and edit a line to relocate that root to another disk. See README "Layout".
#
#   AGENTBOX_CONFIG  instance configuration (agents, prompts, LiteLLM overlay).
#                    Default: <checkout>/config (i.e. $AGENTBOX_HOST_REPO/config).
#                    Gitignored in this repo, so it may be its own git repo. Written by the UI.
#                    To keep config off the checkout, point it at its own dir, e.g.
#                    AGENTBOX_CONFIG=/data/agentbox-config.
#   AGENTBOX_DATA    instance state (runs, outputs, workspaces, credentials, keys).
#                    Default: /data/agentbox. Backed up as a unit.
#AGENTBOX_CONFIG=/home/vortex/GitHub/agentbox/config
#AGENTBOX_DATA=/data/agentbox

# --- Host & repo ------------------------------------------------------------
# Absolute path of this checkout on the Docker host. The orchestrator runs inside a container
# but launches agent containers via the host's Docker socket, so it needs the *host* path to
# bind-mount prompt files. It is also the base for the default config root (<host repo>/config).
# Defaults to /home/vortex/GitHub/agentbox.
AGENTBOX_HOST_REPO=/home/vortex/GitHub/agentbox

# GitHub personal access token (classic ghp_ or fine-grained github_pat_) for repo access.
# Forwarded into agent containers that declare GITHUB_TOKEN in their env.
GITHUB_TOKEN=ghp_...

# Board-read token for the GitHub Projects status trigger (spec 016). Read ONLY by the
# project_status_<name> sensor in the daemon process — never forwarded to an agent container,
# tagged, logged, or filed, and with NO fallback to GITHUB_TOKEN. Needs board read scope: a
# classic PAT with `read:project` + repo read, or a fine-grained token with Projects: read plus
# Contents/Issues: read.
GITHUB_PROJECT_TOKEN=github_pat_...

# --- Dagster ----------------------------------------------------------------
# DAGSTER_HOME is Dagster's own storage root (run DB, compute logs, PIPES transport) — the
# third layout root, holding nothing agentbox-owned. The rest tune the webserver and its links.
#DAGSTER_HOME=/data/dagster          # storage root (uncomment to relocate to another disk)
DAGSTER_HOST_PORT=3000               # host port that publishes the Dagster UI
#DAGSTER_PUBLIC_URL=                  # browser-facing base for the UI's Dagster links; blank = derive from the request host + DAGSTER_HOST_PORT. Set it to the host base (e.g. http://10.0.0.100) when Dagster is behind a different host/proxy than the UI; DAGSTER_HOST_PORT is appended unless you include a port yourself.
#DAGSTER_LOCATION=definitions.py      # code-location name used in job links (/locations/<name>/jobs/<job>)

# --- Box runtime ------------------------------------------------------------
# Host user the `ui` container runs as, so agent/prompt files it writes into the config root
# stay owned by you rather than root; bootstrap.sh also chowns the data-root subtree to this
# user. Find yours with `id -u` (uid) and `id -g` (gid). Defaults to 1000:1000.
AGENTBOX_UID=1000
AGENTBOX_GID=1000

# The box's clock: run-timestamp filenames/log paths AND the timezone agent crons run in
# (triggers:). Unset = UTC.
TZ=America/New_York

# --- LiteLLM proxy ----------------------------------------------------------
# Admin key for the LiteLLM proxy. Also the key every api-harness agent presents to the proxy
# (the orchestrator forwards it into the container as LITELLM_KEY). The proxy's model tiers are
# backed by the provider keys in the Model providers section (referenced by the overlay as
# os.environ/<NAME>; litellm/generate.py fails at render time if a referenced key is unset).
LITELLM_MASTER_KEY=sk-change-me

# --- Model providers --------------------------------------------------------
# One block per provider. The api_key names below must match the os.environ/<NAME> references
# in config/litellm.overlay.yaml for the tiers you use.

# Anthropic (Claude)
#   ANTHROPIC_API_KEY       backs the LiteLLM Claude aliases (cheap/smart/opus) — every
#                           api-harness agent using them.
#   CLAUDE_CODE_OAUTH_TOKEN authenticates the claude-code harness. Run `claude setup-token`
#                           once (needs a Claude subscription + browser) and paste the printed
#                           long-lived token; the orchestrator forwards it into each agent
#                           container. Leave unset to fall back to a copied login in
#                           $AGENTBOX_DATA/credentials/claude/.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_CODE_OAUTH_TOKEN=

# Moonshot (Kimi)
#   KIMI_API_KEY  backs the LiteLLM kimi / kimi-k3 aliases (Moonshot platform, platform.moonshot.ai).
KIMI_API_KEY=sk-...

# OpenAI (Codex)
#   No env var. The codex harness authenticates from a dedicated device login stored in
#   $AGENTBOX_DATA/credentials/codex/ (mounted as CODEX_HOME), which codex refreshes itself.
#   Set it up once — see README "Codex credentials":
#     docker run -it --rm -v "$AGENTBOX_DATA"/credentials/codex:/creds agentbox/agent-codex login --device-auth
